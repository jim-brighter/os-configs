[Unit]
Description=Valheim Dedicated Server
Wants=network-online.target
After=network-online.target

[Service]
Environment="BOX64_PATH=.:bin:/usr/local/bin:/usr/bin"
Environment="BOX64_LD_LIBRARY_PATH=/home/vhserver/valheim_server/doorstop_libs:/home/vhserver/valheim_server/linux64:$LD_LIBRARY_PATH"
Environment="DOORSTOP_ENABLED=1"
Environment="DOORSTOP_TARGET_ASSEMBLY=/home/vhserver/valheim_server/BepInEx/core/BepInEx.Preloader.dll"
Environment="LD_LIBRARY_PATH=/home/vhserver/valheim_server/doorstop_libs:/home/vhserver/valheim_server/linux64:$LD_LIBRARY_PATH"
Environment="LD_PRELOAD=libdoorstop_x64.so"
Environment=SteamAppId=892970
Type=simple
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
WorkingDirectory=/home/vhserver/valheim_server
ExecStart=/home/vhserver/valheim_server/valheim_server.x86_64 \
-nographics -batchmode \
-name '<name>' \
-password <password> \
-port <port> \
-world <world> \
-public 0 \
-savedir '/home/vhserver/valheim_server/valheim_data' \
-saveinterval 1800 \
-backups 7 \
-backupshort 7200 \
-backuplong 43200 \
-instanceid 1 \
-modifier deathPenalty casual \
-modifier raids less \
-modifier portals casual

[Install]
WantedBy=default.target
